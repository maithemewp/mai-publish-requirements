{
    "name": "maithemewp/mai-publish-requirements",
    "description": "Require a featured image (and other per-post-type rules) before a post can be published.",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "BizBudding",
            "homepage": "https://bizbudding.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "yahnis-elsts/plugin-update-checker": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^2.0",
        "bizbudding/deployable-guard": "^1"
    },
    "autoload": {
        "psr-4": {
            "Mai\\PublishRequirements\\": "includes/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "install-git-hooks": [
            "sh -c 'test -f vendor/bin/deployable-guard && php vendor/bin/deployable-guard install-hook || true'"
        ],
        "post-install-cmd": [
            "@install-git-hooks"
        ],
        "post-update-cmd": [
            "@install-git-hooks"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bizbudding/deployable-guard"
        }
    ]
}
